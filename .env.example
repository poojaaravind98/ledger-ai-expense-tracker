# ===================================================
# Ledger AI Expense Tracker - Environment Variables
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=ledger_jwt_secure_key_change_in_production
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Database Connection (SQLite default for zero-setup local dev, PostgreSQL for Docker/Cloud)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://ledger_user:ledger_password@localhost:5432/ledger_db?schema=public"

# AI Provider Configuration (Unified LLM Layer: openai | claude | mock)
LLM_PROVIDER=mock
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Frontend API URL (for client/.env)
VITE_API_URL=http://localhost:5000/api
